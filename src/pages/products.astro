---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";

const distilled = {
  glycols: ["Mono Ethylene Glycol (MEG)", "Diethylene Glycol (DEG)", "Triethylene Glycol (TEG)"],
  chlorinated: ["Trichloroethylene (TCE)", "EDC LE"],
};

const pure = {
  glycols: ["Mono Ethylene Glycol (MEG)", "Diethylene Glycol (DEG)"],
  chlorinated: ["SRSolv"],
};

const applications = ["Boats", "Quartz & Marble", "FRP", "Roofing Sheets"];
---

<BaseLayout
  title="Products | S R Group"
  description="The full product range across S R Industries, S R Plast, and S R Polymers — distilled and pure glycols and chlorinated solvents, and Unsaturated Polyester Resin."
>

<!-- ================= INTRO ================= -->
<section class="prod-intro">
  <Container>
    <span class="eyebrow">PRODUCT CATALOGUE</span>
    <h1>Our Product Range</h1>
    <p class="lead">
      Chemicals manufactured and supplied across S R Group — distilled and
      pure glycols and chlorinated solvents from S R Industries and S R
      Plast, and Unsaturated Polyester Resin from S R Polymers.
    </p>
  </Container>
</section>

<!-- ================= S R INDUSTRIES & S R PLAST ================= -->
<section class="prod-group">
  <Container>
    <span class="eyebrow">S R INDUSTRIES &amp; S R PLAST</span>
    <h2>Glycols &amp; Chlorinated Solvents</h2>

    <div class="category-grid">
      <div class="category-block" id="distilled">
        <h3>Distilled</h3>

        <div class="category-group">
          <span class="group-label">Glycols</span>
          <ul>
            {distilled.glycols.map((item) => <li>{item}</li>)}
          </ul>
        </div>

        <div class="category-group">
          <span class="group-label">Chlorinated</span>
          <ul>
            {distilled.chlorinated.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>

      <div class="category-block" id="pure">
        <h3>Pure</h3>

        <div class="category-group">
          <span class="group-label">Glycols</span>
          <ul>
            {pure.glycols.map((item) => <li>{item}</li>)}
          </ul>
        </div>

        <div class="category-group">
          <span class="group-label">Chlorinated</span>
          <ul>
            {pure.chlorinated.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </div>

    <div class="group-link">
      <a href={`${import.meta.env.BASE_URL}companies/industries`}>
        Learn more about S R Industries &amp; S R Plast
      </a>
    </div>
  </Container>
</section>

<!-- ================= S R POLYMERS ================= -->
<section class="prod-group prod-group-alt">
  <Container>
    <span class="eyebrow">S R POLYMERS</span>
    <h2>Unsaturated Polyester Resin</h2>

    <div class="product-block" id="polymers">
      <h3>Unsaturated Polyester Resin</h3>

      <div class="category-group">
        <span class="group-label">Applications</span>
        <ul>
          {applications.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <!-- GRADE LIST: replace/extend with specific grade names once provided -->
    </div>

    <div class="group-link">
      <a href={`${import.meta.env.BASE_URL}companies/polymers`}>
        Learn more about S R Polymers
      </a>
    </div>
  </Container>
</section>

</BaseLayout>


<style>

/* ---------- shared ---------- */

.eyebrow{
  display:inline-block;
  margin-bottom:1.25rem;
  font-size:.95rem;
  font-weight:700;
  letter-spacing:.24em;
  text-transform:uppercase;
  color:var(--color-accent);
  border-left:3px solid var(--color-accent);
  padding-left:.75rem;
}

.lead{
  font-size:1.1rem;
  line-height:1.9;
  color:var(--color-text-light);
  max-width:64ch;
}

/* ---------- intro ---------- */

.prod-intro{
  padding:7rem 0 5rem;
}

.prod-intro h1{
  margin:0 0 1.5rem;
  font-family:var(--font-heading);
  font-size:clamp(2.8rem,5vw,4.4rem);
  line-height:1.05;
  color:var(--color-primary);
}

/* ---------- groups ---------- */

.prod-group{
  padding:5rem 0;
  scroll-margin-top:130px;
}

.prod-group-alt{
  background:#F5F1E9;
}

.prod-group h2{
  margin:.5rem 0 3rem;
  font-family:var(--font-heading);
  font-size:clamp(2.2rem,3.5vw,3.2rem);
  color:var(--color-primary);
}

/* ---------- distilled / pure ---------- */

.category-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:3rem;
}

.category-block{
  padding:2.5rem;
  background:var(--color-bg);
  border:1px solid var(--color-border);
  border-radius:var(--radius);
  scroll-margin-top:130px;
}

.category-block h3{
  margin:0 0 1.75rem;
  font-family:var(--font-heading);
  font-size:1.75rem;
  color:var(--color-primary);
}

.category-group{
  margin-bottom:1.5rem;
}

.category-group:last-child{
  margin-bottom:0;
}

.group-label{
  display:block;
  margin-bottom:.6rem;
  font-size:.7rem;
  font-weight:600;
  letter-spacing:.16em;
  text-transform:uppercase;
  color:var(--color-accent);
}

.category-group ul{
  margin:0;
  padding:0;
  list-style:none;
}

.category-group li{
  padding:.4rem 0;
  font-size:1rem;
  color:var(--color-text);
  border-bottom:1px solid var(--color-border);
}

.category-group li:last-child{
  border-bottom:none;
}

/* ---------- polymers product block ---------- */

.product-block{
  padding:2.5rem;
  background:var(--color-white);
  border:1px solid var(--color-border);
  border-radius:var(--radius);
  max-width:560px;
  scroll-margin-top:130px;
}

.product-block h3{
  margin:0 0 1.75rem;
  font-family:var(--font-heading);
  font-size:1.75rem;
  color:var(--color-primary);
}

/* ---------- group link ---------- */

.group-link{
  margin-top:3rem;
}

.group-link a{
  font-size:.95rem;
  font-weight:600;
  color:var(--color-primary);
  text-decoration:none;
  border-bottom:1px solid var(--color-accent);
  padding-bottom:2px;
}

.group-link a:hover{
  color:var(--color-accent);
}

/* ---------- responsive ---------- */

@media(max-width:1000px){
  .category-grid{
    grid-template-columns:1fr;
  }
}

@media(max-width:600px){
  .prod-intro{
    padding:5rem 0 4rem;
  }

  .prod-group{
    padding:4rem 0;
  }
}

</style>
