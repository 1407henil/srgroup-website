---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/ui/Container.astro";
---

<BaseLayout
  title="S R Industries & S R Plast | S R Group"
  description="S R Industries and S R Plast are part of S R Group's chemical manufacturing business, with specialized expertise in glycol distillation."
>

<section class="hero">

  <Container>

    <span class="eyebrow">
      CHEMICAL MANUFACTURING
    </span>

    <h1>
      S R Industries<br />
      &amp; S R Plast
    </h1>

    <h2>
      Chemical Manufacturing with<br />
      Specialized Glycol Distillation
    </h2>

    <p>
      Since 1997, S R Industries and S R Plast have built expertise in chemical
      manufacturing, with specialized capabilities in glycol distillation and
      manufacturing.
    </p>

    <div class="facts">

      <div class="fact">
        <span>Established</span>
        <strong>1997</strong>
      </div>

      <div class="fact">
        <span>Location</span>
        <strong>Chhatral GIDC, Gujarat, India</strong>
      </div>

      <div class="fact">
        <span>Specialization</span>
        <strong>Glycol Distillation</strong>
      </div>

      <div class="fact">
        <span>Business</span>
        <strong>Chemical Manufacturing</strong>
      </div>

    </div>

  </Container>

</section>


<section class="about">

  <Container>

    <div class="about-grid">

      <div>

        <span class="section-title">
          ABOUT
        </span>

        <h2>
          Chemical Manufacturing<br />
          Since 1997
        </h2>

      </div>

      <div class="about-content">

        <p>
          Established in 1997, S R Industries and S R Plast are part of S R
          Group's chemical manufacturing business. Over the years, the
          companies have developed specialized expertise in chemical
          manufacturing, with glycol distillation forming an important area
          of capability.
        </p>

        <p>
          With a focus on consistent quality and reliable manufacturing,
          the business operates with state-of-the-art manufacturing plant
          and facilities to support its industrial chemical operations.
        </p>

      </div>

    </div>

  </Container>

</section>


<section class="specialization">

  <Container>

    <div class="specialization-header">

      <span class="section-title">
        CORE SPECIALIZATION
      </span>

      <h2>
        Specialized in Glycol Distillation
      </h2>

      <p>
        Glycol distillation is a key area of our chemical manufacturing
        expertise. Our experience in distillation and purification enables
        us to process glycol-based materials to meet defined industrial
        requirements with consistent batch quality.
      </p>

    </div>

    <div class="capability-grid">

      <article class="featured-card">

        <span class="card-number">01</span>

        <h3>
          Glycol Distillation
        </h3>

        <p>
          Specialized distillation and purification of glycol-based
          materials.
        </p>

      </article>

      <article>

        <span class="card-number">02</span>

        <h3>
          Purification
        </h3>

        <p class="placeholder">
          Write confirmed purification capability/details here.
        </p>

      </article>

      <article>

        <span class="card-number">03</span>

        <h3>
          Chemical Processing
        </h3>

        <p class="placeholder">
          Write confirmed chemical processing capability here.
        </p>

      </article>

      <article>

        <span class="card-number">04</span>

        <h3>
          Custom Requirements
        </h3>

        <p class="placeholder">
          Write whether custom processing/formulation is actually offered
          here.
        </p>

      </article>

    </div>

  </Container>

</section>


<section class="products">

  <Container>

    <div class="section-heading">

      <div>

        <span class="section-title">
          SELECTED PRODUCTS
        </span>

        <h2>
          Our Chemical Products
        </h2>

      </div>

      <p>
        A selection from our chemical manufacturing portfolio. Detailed
        product information is available in our dedicated product catalogue.
      </p>

    </div>

    <div class="product-grid">

      <article class="product-card">

        <span class="product-category">
          Industrial Cleaning Solvent
        </span>

        <h3>
          SRSolv
        </h3>

        <p>
          Industrial cleaning solvent developed for heavy-duty metal
          degreasing and component cleaning.
        </p>

      </article>

      <article class="product-card">

        <span class="product-category">
          Glycol
        </span>

        <h3>
          Distilled Mono Ethylene Glycol
        </h3>

        <p>
          Purified Mono Ethylene Glycol supplied for industrial processing
          applications.
        </p>

      </article>

      <article class="product-card">

        <span class="product-category">
          Glycol
        </span>

        <h3>
          Distilled Diethylene Glycol
        </h3>

        <p>
          Distilled Diethylene Glycol supplied for industrial manufacturing
          requirements.
        </p>

      </article>

      <article class="product-card placeholder-card">

        <span class="product-category">
          Additional Product
        </span>

        <h3 class="placeholder">
          Product Name 4
        </h3>

        <p class="placeholder">
          Write your actual product name and short description here.
        </p>

      </article>

    </div>

    <div class="catalogue-link">

      <a
        href={`${import.meta.env.BASE_URL}companies/industries/products`}
        class="button"
      >
        Explore All Products →
      </a>

    </div>

  </Container>

</section>


<section class="applications">

  <Container>

    <div class="applications-header">

      <span class="section-title">
        APPLICATIONS
      </span>

      <h2>
        Applications Across Industries
      </h2>

      <p class="placeholder">
        Add 4–6 confirmed industries or applications served by S R Industries
        &amp; S R Plast here.
      </p>

    </div>

    <div class="application-grid">

      <div class="application-card placeholder">
        Industry / Application 1
      </div>

      <div class="application-card placeholder">
        Industry / Application 2
      </div>

      <div class="application-card placeholder">
        Industry / Application 3
      </div>

      <div class="application-card placeholder">
        Industry / Application 4
      </div>

    </div>

  </Container>

</section>


<section class="credibility">

  <Container>

    <div class="credibility-grid">

      <div>
        <strong>1997</strong>
        <span>Established</span>
      </div>

      <div>
        <strong>Glycol</strong>
        <span>Distillation Expertise</span>
      </div>

      <div>
        <strong>Consistent</strong>
        <span>Manufacturing</span>
      </div>

      <div>
        <strong>B2B</strong>
        <span>Industrial Focus</span>
      </div>

    </div>

  </Container>

</section>


<section class="cta">

  <Container>

    <span class="section-title">
      PRODUCTS
    </span>

    <h2>
      Looking for a Specific Chemical Product?
    </h2>

    <p>
      Explore our range of industrial chemicals and specialized glycol-based
      products.
    </p>

    <div class="cta-actions">

      <a
        href={`${import.meta.env.BASE_URL}companies/industries/products`}
        class="button"
      >
        Explore Our Products →
      </a>

      <a
        href={`${import.meta.env.BASE_URL}contact`}
        class="button secondary"
      >
        Contact Our Team →
      </a>

    </div>

  </Container>

</section>

</BaseLayout>


<style>

.hero{
padding:8rem 0 5rem;
text-align:center;
}

.eyebrow{
display:inline-block;
margin-bottom:1.25rem;
font-size:.8rem;
font-weight:600;
letter-spacing:.28em;
text-transform:uppercase;
color:var(--color-accent);
}

.hero h1{
margin:0;
font-family:var(--font-heading);
font-size:clamp(3.2rem,6vw,5.4rem);
line-height:1;
color:var(--color-primary);
}

.hero h2{
margin:1.75rem 0 0;
font-family:var(--font-heading);
font-size:clamp(1.7rem,3vw,2.5rem);
font-weight:500;
line-height:1.25;
color:var(--color-primary);
}

.hero > .container > p{
max-width:760px;
margin:2rem auto 0;
font-size:1.12rem;
line-height:1.9;
color:var(--color-text-light);
}

.facts{
max-width:1000px;
margin:4rem auto 0;
display:grid;
grid-template-columns:repeat(4,1fr);
border-top:1px solid var(--color-border);
border-bottom:1px solid var(--color-border);
}

.fact{
padding:1.5rem 1rem;
display:flex;
flex-direction:column;
gap:.45rem;
border-right:1px solid var(--color-border);
}

.fact:last-child{
border-right:none;
}

.fact span{
font-size:.7rem;
font-weight:600;
letter-spacing:.2em;
text-transform:uppercase;
color:var(--color-accent);
}

.fact strong{
font-size:.95rem;
font-weight:600;
color:var(--color-primary);
}

.about{
padding:7rem 0;
}

.about-grid{
display:grid;
grid-template-columns:38% 62%;
gap:5rem;
}

.section-title{
display:inline-block;
margin-bottom:1rem;
font-size:.75rem;
font-weight:600;
letter-spacing:.28em;
text-transform:uppercase;
color:var(--color-accent);
}

.about h2,
.specialization h2,
.products h2,
.applications h2{
margin:0;
font-family:var(--font-heading);
font-size:clamp(2.5rem,4vw,3.6rem);
line-height:1.15;
color:var(--color-primary);
}

.about-content{
max-width:760px;
}

.about-content p{
margin:0 0 1.5rem;
font-size:1.08rem;
line-height:2;
color:var(--color-text-light);
}

.specialization{
padding:7rem 0;
background:rgba(255,255,255,.45);
}

.specialization-header{
max-width:820px;
}

.specialization-header p{
margin:1.75rem 0 0;
font-size:1.08rem;
line-height:2;
color:var(--color-text-light);
}

.capability-grid{
margin-top:4rem;
display:grid;
grid-template-columns:repeat(4,1fr);
gap:1.5rem;
}

.capability-grid article{
min-height:220px;
padding:2.25rem;
border:1px solid var(--color-border);
border-radius:20px;
background:#fff;
transition:.3s ease;
}

.capability-grid article:hover{
transform:translateY(-4px);
box-shadow:0 18px 40px rgba(0,0,0,.05);
}

.capability-grid .featured-card{
background:var(--color-primary);
border-color:var(--color-primary);
}

.card-number{
display:block;
margin-bottom:3rem;
font-size:.7rem;
font-weight:600;
letter-spacing:.2em;
color:var(--color-accent);
}

.capability-grid h3{
margin:0 0 1rem;
font-family:var(--font-heading);
font-size:1.65rem;
color:var(--color-primary);
}

.featured-card h3{
color:#fff;
}

.capability-grid p{
margin:0;
line-height:1.8;
color:var(--color-text-light);
}

.featured-card p{
color:rgba(255,255,255,.75);
}

.products{
padding:7rem 0;
}

.section-heading{
display:grid;
grid-template-columns:1fr .8fr;
gap:4rem;
align-items:end;
}

.section-heading > p{
margin:0;
line-height:1.9;
color:var(--color-text-light);
}

.product-grid{
margin-top:4rem;
display:grid;
grid-template-columns:repeat(4,1fr);
gap:1.5rem;
}

.product-card{
padding:2.25rem;
border:1px solid var(--color-border);
border-radius:20px;
background:#fff;
transition:.3s ease;
}

.product-card:hover{
transform:translateY(-4px);
box-shadow:0 18px 40px rgba(0,0,0,.05);
}

.product-category{
display:block;
margin-bottom:1rem;
font-size:.7rem;
font-weight:600;
letter-spacing:.2em;
text-transform:uppercase;
color:var(--color-accent);
}

.product-card h3{
margin:0 0 1rem;
font-family:var(--font-heading);
font-size:1.65rem;
line-height:1.2;
color:var(--color-primary);
}

.product-card p{
margin:0;
line-height:1.8;
color:var(--color-text-light);
}

.placeholder-card{
border-style:dashed;
}

.catalogue-link{
margin-top:3rem;
text-align:center;
}

.button{
display:inline-flex;
align-items:center;
justify-content:center;
padding:1rem 2.25rem;
border:1px solid var(--color-accent);
border-radius:999px;
text-decoration:none;
font-weight:600;
color:var(--color-primary);
transition:.3s ease;
}

.button:hover{
background:var(--color-accent);
color:#fff;
}

.applications{
padding:7rem 0;
background:rgba(255,255,255,.45);
}

.applications-header{
max-width:760px;
}

.applications-header p{
margin:1.5rem 0 0;
line-height:1.9;
color:var(--color-text-light);
}

.application-grid{
margin-top:3rem;
display:grid;
grid-template-columns:repeat(4,1fr);
gap:1.5rem;
}

.application-card{
min-height:120px;
padding:1.75rem;
display:flex;
align-items:center;
border:1px solid var(--color-border);
border-radius:18px;
background:#fff;
font-weight:600;
}

.credibility{
padding:3.5rem 0;
border-top:1px solid var(--color-border);
border-bottom:1px solid var(--color-border);
}

.credibility-grid{
display:grid;
grid-template-columns:repeat(4,1fr);
}

.credibility-grid > div{
padding:1rem 2rem;
text-align:center;
border-right:1px solid var(--color-border);
}

.credibility-grid > div:last-child{
border-right:none;
}

.credibility strong{
display:block;
font-family:var(--font-heading);
font-size:2rem;
color:var(--color-primary);
}

.credibility span{
display:block;
margin-top:.4rem;
font-size:.85rem;
color:var(--color-text-light);
}

.cta{
padding:7rem 0 8rem;
text-align:center;
}

.cta h2{
margin:0;
font-family:var(--font-heading);
font-size:clamp(2.4rem,4vw,3.5rem);
color:var(--color-primary);
}

.cta > .container > p{
max-width:650px;
margin:1.5rem auto 2.5rem;
line-height:1.9;
color:var(--color-text-light);
}

.cta-actions{
display:flex;
justify-content:center;
gap:1rem;
flex-wrap:wrap;
}

.secondary{
background:transparent;
}

.placeholder{
font-style:italic;
}

@media(max-width:1000px){

.facts{
grid-template-columns:repeat(2,1fr);
}

.fact:nth-child(2){
border-right:none;
}

.capability-grid{
grid-template-columns:repeat(2,1fr);
}

.product-grid{
grid-template-columns:repeat(2,1fr);
}

.application-grid{
grid-template-columns:repeat(2,1fr);
}

.section-heading{
grid-template-columns:1fr;
gap:1.5rem;
}

}

@media(max-width:900px){

.hero{
padding:6rem 0 4rem;
}

.about,
.specialization,
.products,
.applications{
padding:5rem 0;
}

.about-grid{
grid-template-columns:1fr;
gap:3rem;
}

.facts{
margin-top:3rem;
}

.credibility-grid{
grid-template-columns:repeat(2,1fr);
}

.credibility-grid > div:nth-child(2){
border-right:none;
}

.credibility-grid > div:nth-child(-n+2){
border-bottom:1px solid var(--color-border);
}

}

@media(max-width:600px){

.hero h1{
font-size:3rem;
}

.hero h2{
font-size:1.65rem;
}

.facts,
.capability-grid,
.product-grid,
.application-grid,
.credibility-grid{
grid-template-columns:1fr;
}

.fact{
border-right:none;
border-bottom:1px solid var(--color-border);
}

.fact:last-child{
border-bottom:none;
}

.capability-grid article{
min-height:0;
}

.product-grid{
gap:1rem;
}

.credibility-grid > div{
border-right:none !important;
border-bottom:1px solid var(--color-border);
}

.credibility-grid > div:last-child{
border-bottom:none;
}

.cta{
padding:5rem 0 6rem;
}

}
