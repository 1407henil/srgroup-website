---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";

const applications = ["Boats", "Quartz & Marble", "FRP", "Roofing Sheets"];

const distilledGlycols = ["Mono Ethylene Glycol (MEG)", "Diethylene Glycol (DEG)", "Triethylene Glycol (TEG)"];
const pureGlycols = ["Mono Ethylene Glycol (MEG)", "Diethylene Glycol (DEG)"];

const distilledChlorinated = ["Trichloroethylene (TCE)", "EDC LE"];
const pureChlorinated = ["SRSolv"];
---

<BaseLayout
  title="Products | S R Group"
  description="The full product range across S R Group — Unsaturated Polyester Resin from S R Polymers, and Ethylene Glycols and Chlorinated Solvents from S R Industries and S R Plast."
>

<!-- ================= INTRO ================= -->
<section class="prod-intro">
  <Container>
    <span class="eyebrow">PRODUCT CATALOGUE</span>
    <h1>Our Product Range</h1>
    <p class="lead">
      S R Group's manufacturing spans three product categories. S R Polymers
      manufactures Unsaturated Polyester Resin across multiple grades, while
      S R Industries and S R Plast produce Ethylene Glycols and Chlorinated
      Solvents, each available in distilled and pure grades.
    </p>
  </Container>
</section>

<!-- ================= UNSATURATED POLYESTER RESIN ================= -->
<section class="prod-group" id="polymers">
  <Container>
    <span class="eyebrow">S R POLYMERS</span>
    <h2>Unsaturated Polyester Resin</h2>

    <div class="product-block">
      <div class="category-group">
        <span class="group-label">Applications</span>
        <ul>
          {applications.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <!-- Grade list to be added once provided -->
    </div>

    <div class="group-link">
      <a href={`${import.meta.env.BASE_URL}products/unsaturated-polyester-resin`}>
        View Unsaturated Polyester Resin
      </a>
    </div>
  </Container>
</section>

<!-- ================= ETHYLENE GLYCOLS ================= -->
<section class="prod-group prod-group-alt" id="glycols">
  <Container>
    <span class="eyebrow">S R INDUSTRIES &amp; S R PLAST</span>
    <h2>Ethylene Glycols</h2>

    <div class="category-grid">
      <div class="category-block">
        <h3>Distilled</h3>
        <ul>
          {distilledGlycols.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <div class="category-block">
        <h3>Pure</h3>
        <ul>
          {pureGlycols.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>

    <div class="group-link">
      <a href={`${import.meta.env.BASE_URL}products/ethylene-glycols`}>
        View Ethylene Glycols
      </a>
    </div>
  </Container>
</section>

<!-- ================= CHLORINATED SOLVENTS ================= -->
<section class="prod-group" id="chlorinated">
  <Container>
    <span class="eyebrow">S R INDUSTRIES &amp; S R PLAST</span>
    <h2>Chlorinated Solvents</h2>

    <div class="category-grid">
      <div class="category-block">
        <h3>Distilled</h3>
        <ul>
          {distilledChlorinated.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <div class="category-block">
        <h3>Pure</h3>
        <ul>
          {pureChlorinated.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>

    <div class="group-link">
      <a href={`${import.meta.env.BASE_URL}products/chlorinated-solvents`}>
        View Chlorinated Solvents
      </a>
    </div>
  </Container>
</section>

</BaseLayout>

<style>

.eyebrow{
  display:inline-block;
  margin-bottom:1.25rem;
  font-size:.95rem;
  font-weight:700;
  letter-spacing:.24em;
  text-transform:uppercase;
  color:var(--color-accent);
  border-left:3px solid var(--color-accent);
  padding-left:.75rem;
}

.lead{
  font-size:1.1rem;
  line-height:1.9;
  color:var(--color-text-light);
  max-width:64ch;
}

.prod-intro{
  padding:7rem 0 5rem;
}

.prod-intro h1{
  margin:0 0 1.5rem;
  font-family:var(--font-heading);
  font-size:clamp(2.8rem,5vw,4.4rem);
  line-height:1.05;
  color:var(--color-primary);
}

.prod-group{
  padding:5rem 0;
  scroll-margin-top:130px;
}

.prod-group-alt{
  background:#F5F1E9;
}

.prod-group h2{
  margin:.5rem 0 3rem;
  font-family:var(--font-heading);
  font-size:clamp(2.2rem,3.5vw,3.2rem);
  color:var(--color-primary);
}

.category-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:3rem;
}

.category-block{
  padding:2.5rem;
  background:var(--color-white);
  border:1px solid var(--color-border);
  border-radius:var(--radius);
}

.category-block h3{
  margin:0 0 1.5rem;
  font-family:var(--font-heading);
  font-size:1.5rem;
  color:var(--color-primary);
}

.category-block ul{
  margin:0;
  padding:0;
  list-style:none;
}

.category-block li{
  padding:.4rem 0;
  font-size:1rem;
  color:var(--color-text);
  border-bottom:1px solid var(--color-border);
}

.category-block li:last-child{
  border-bottom:none;
}

.product-block{
  padding:2.5rem;
  background:var(--color-white);
  border:1px solid var(--color-border);
  border-radius:var(--radius);
  max-width:560px;
}

.category-group{
  margin-bottom:0;
}

.group-label{
  display:block;
  margin-bottom:.6rem;
  font-size:.7rem;
  font-weight:600;
  letter-spacing:.16em;
  text-transform:uppercase;
  color:var(--color-accent);
}

.category-group ul{
  margin:0;
  padding:0;
  list-style:none;
}

.category-group li{
  padding:.4rem 0;
  font-size:1rem;
  color:var(--color-text);
  border-bottom:1px solid var(--color-border);
}

.category-group li:last-child{
  border-bottom:none;
}

.group-link{
  margin-top:2.5rem;
}

.group-link a{
  font-size:.95rem;
  font-weight:600;
  color:var(--color-primary);
  text-decoration:none;
  border-bottom:1px solid var(--color-accent);
  padding-bottom:2px;
}

.group-link a:hover{
  color:var(--color-accent);
}

@media(max-width:900px){
  .category-grid{
    grid-template-columns:1fr;
  }
}

@media(max-width:600px){
  .prod-intro{
    padding:5rem 0 4rem;
  }

  .prod-group{
    padding:4rem 0;
  }
}

</style>
