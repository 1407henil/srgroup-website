---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/ui/Container.astro";

const capabilities = [
  {
    title: "Established 2012",
    text: "A newer addition to S R Group's manufacturing operations, built specifically for resin production.",
  },
  {
    title: "Purpose-Built Facility",
    text: "Operates from its own facility within Chhatral GIDC, developed separately from our original site, with updated production infrastructure.",
  },
  {
    title: "Multi-Grade Production",
    text: "Equipped to manufacture Unsaturated Polyester Resin across multiple grades for different applications.",
  },
  {
    title: "Consistent Batch Quality",
    text: "Quality checked at each stage to maintain consistency, batch after batch.",
  },
  {
    title: "High-Volume Manufacturing",
    text: "Built to handle large manufacturing volumes, supporting consistent, large-scale supply.",
  },
  {
    title: "Reliable Packaging & Dispatch",
    text: "Products packaged and dispatched to meet agreed delivery schedules.",
  },
];

const applications = ["Boats", "Quartz & Marble", "FRP", "Roofing Sheets"];
---

<BaseLayout
  title="S R Polymers | S R Group"
  description="S R Polymers manufactures Unsaturated Polyester Resin across multiple grades, from our facility in Chhatral GIDC, Gujarat."
>

<!-- ================= STATEMENT ================= -->
<section class="poly-statement">
  <Container>
    <div class="poly-statement-grid">
      <div class="poly-statement-text">
        <span class="eyebrow">S R POLYMERS</span>

        <h1>Strength, engineered into every grade.</h1>

        <p class="lead">
          S R Polymers manufactures Unsaturated Polyester Resin from our
          facility in Chhatral GIDC, Gujarat — built to serve applications
          from marine construction to quartz and roofing.
        </p>

        <div class="facts">
          <div class="fact">
            <span>Established</span>
            <strong>2012</strong>
          </div>
          <div class="fact">
            <span>Location</span>
            <strong>Chhatral GIDC, Gujarat</strong>
          </div>
          <div class="fact">
            <span>Specialization</span>
            <strong>Unsaturated Polyester Resin</strong>
          </div>
        </div>
      </div>

      <!-- PHOTO SLOT: wide facility exterior or plant overview shot -->
      <div class="photo-slot photo-tall">
        <span>Facility photo</span>
      </div>
    </div>
  </Container>
</section>

<!-- ================= STORY ================= -->
<section class="poly-story">
  <Container>
    <div class="poly-story-grid">
      <!-- PHOTO SLOT: production line / resin plant close-up -->
      <div class="photo-slot photo-square">
        <span>Facility photo</span>
      </div>

      <div class="poly-story-text">
        <span class="eyebrow">OUR STORY</span>
        <h2>A Purpose-Built Facility in Chhatral GIDC</h2>

        <p>
          S R Polymers was established in 2012, operating from its own
          facility within Chhatral GIDC, Gujarat — developed on a separate
          plot from our original site, with more current production
          infrastructure built around it.
        </p>

        <p>
          The plant manufactures Unsaturated Polyester Resin at scale,
          supplying grades used across marine construction, quartz and
          marble composites, FRP applications, and roofing sheets.
        </p>
      </div>
    </div>
  </Container>
</section>

<!-- ================= PROOF ================= -->
<section class="poly-proof">
  <Container>
    <span class="eyebrow">CAPABILITIES</span>
    <h2>Manufacturing Capabilities</h2>

    <div class="capability-grid">
      {capabilities.map((item) => (
        <div class="capability-card">
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </div>
      ))}
    </div>
  </Container>
</section>

<!-- ================= PRODUCTS ================= -->
<section class="poly-products">
  <Container>
    <span class="eyebrow">PRODUCT RANGE</span>
    <h2>Our Product Range</h2>
    <p class="lead">
      Unsaturated Polyester Resin, manufactured across multiple grades
      developed for the applications below.
    </p>

    <div class="product-block">
      <h3>Unsaturated Polyester Resin</h3>

      <div class="category-group">
        <span class="group-label">Applications</span>
        <ul>
          {applications.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <!-- GRADE LIST: replace/extend with specific grade names once provided -->
    </div>

    <div class="catalogue-link">
      <a href={`${import.meta.env.BASE_URL}products`} class="button">
        View Full Product Catalogue
      </a>
    </div>
  </Container>
</section>

<!-- ================= CTA ================= -->
<section class="poly-cta">
  <Container>
    <h2>Looking for a Specific Resin Grade?</h2>
    <p>
      Explore our range of Unsaturated Polyester Resin grades and industrial
      applications.
    </p>

    <div class="cta-actions">
      <a href={`${import.meta.env.BASE_URL}products`} class="button">
        View Product Catalogue
      </a>
      <a href={`${import.meta.env.BASE_URL}contact`} class="button secondary">
        Contact Our Team
      </a>
    </div>
  </Container>
</section>

</BaseLayout>


<style>

/* ---------- shared ---------- */

.eyebrow{
  display:inline-block;
  margin-bottom:1.25rem;
  font-size:.95rem;
  font-weight:700;
  letter-spacing:.24em;
  text-transform:uppercase;
  color:var(--color-accent);
  border-left:3px solid var(--color-accent);
  padding-left:.75rem;
}

.lead{
  font-size:1.1rem;
  line-height:1.9;
  color:var(--color-text-light);
}

.button{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding:1rem 2.25rem;
  border:1px solid var(--color-accent);
  border-radius:999px;
  text-decoration:none;
  font-weight:600;
  color:var(--color-primary);
  transition:var(--transition);
}

.button:hover{
  background:var(--color-accent);
  color:#fff;
}

.button.secondary{
  background:transparent;
}

.photo-slot{
  display:flex;
  align-items:center;
  justify-content:center;
  border:1px dashed var(--color-border);
  border-radius:var(--radius);
  background:#F1EEE6;
  color:var(--color-text-light);
  font-size:.85rem;
  font-style:italic;
}

.photo-tall{
  aspect-ratio:4/5;
}

.photo-square{
  aspect-ratio:1/1;
}

/* ---------- statement ---------- */

.poly-statement{
  padding:7rem 0 6rem;
}

.poly-statement-grid{
  display:grid;
  grid-template-columns:1.1fr .9fr;
  gap:4rem;
  align-items:center;
}

.poly-statement h1{
  margin:0;
  font-family:var(--font-heading);
  font-size:clamp(2.8rem,5vw,4.6rem);
  line-height:1.05;
  color:var(--color-primary);
}

.poly-statement .lead{
  margin:1.75rem 0 0;
  max-width:52ch;
}

.facts{
  margin-top:3rem;
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:1.5rem;
  padding-top:2rem;
  border-top:1px solid var(--color-border);
}

.fact{
  display:flex;
  flex-direction:column;
  gap:.4rem;
}

.fact span{
  font-size:.7rem;
  font-weight:600;
  letter-spacing:.16em;
  text-transform:uppercase;
  color:var(--color-accent);
}

.fact strong{
  font-size:.95rem;
  font-weight:600;
  color:var(--color-primary);
}

/* ---------- story ---------- */

.poly-story{
  padding:6rem 0;
  background:#F5F1E9;
}

.poly-story-grid{
  display:grid;
  grid-template-columns:.85fr 1.15fr;
  gap:4rem;
  align-items:center;
}

.poly-story-text h2{
  margin:0;
  font-family:var(--font-heading);
  font-size:clamp(2.2rem,3.5vw,3.2rem);
  line-height:1.15;
  color:var(--color-primary);
}

.poly-story-text p{
  margin:1.5rem 0 0;
  font-size:1.05rem;
  line-height:1.9;
  color:var(--color-text-light);
  max-width:60ch;
}

/* ---------- proof ---------- */

.poly-proof{
  padding:7rem 0;
}

.poly-proof h2{
  margin:0 0 3.5rem;
  font-family:var(--font-heading);
  font-size:clamp(2.2rem,3.5vw,3.2rem);
  color:var(--color-primary);
}

.capability-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:2px;
  background:var(--color-border);
  border:1px solid var(--color-border);
}

.capability-card{
  padding:2.5rem;
  background:var(--color-bg);
  border-left:3px solid transparent;
  transition:var(--transition);
}

.capability-card:hover{
  border-left-color:var(--color-accent);
  background:#fff;
}

.capability-card h3{
  margin:0 0 .85rem;
  font-family:var(--font-heading);
  font-size:1.4rem;
  color:var(--color-primary);
}

.capability-card p{
  margin:0;
  font-size:.98rem;
  line-height:1.7;
  color:var(--color-text-light);
}

/* ---------- products ---------- */

.poly-products{
  padding:7rem 0;
  background:#F5F1E9;
}

.poly-products h2{
  margin:.5rem 0 0;
  font-family:var(--font-heading);
  font-size:clamp(2.2rem,3.5vw,3.2rem);
  color:var(--color-primary);
}

.poly-products > :global(.container) > .lead{
  margin:1.25rem 0 3.5rem;
  max-width:60ch;
}

.product-block{
  padding:2.5rem;
  background:var(--color-bg);
  border:1px solid var(--color-border);
  border-radius:var(--radius);
  max-width:560px;
}

.product-block h3{
  margin:0 0 1.75rem;
  font-family:var(--font-heading);
  font-size:1.75rem;
  color:var(--color-primary);
}

.category-group{
  margin-bottom:0;
}

.group-label{
  display:block;
  margin-bottom:.6rem;
  font-size:.7rem;
  font-weight:600;
  letter-spacing:.16em;
  text-transform:uppercase;
  color:var(--color-accent);
}

.category-group ul{
  margin:0;
  padding:0;
  list-style:none;
}

.category-group li{
  padding:.4rem 0;
  font-size:1rem;
  color:var(--color-text);
  border-bottom:1px solid var(--color-border);
}

.category-group li:last-child{
  border-bottom:none;
}

.catalogue-link{
  margin-top:3.5rem;
  text-align:center;
}

/* ---------- cta ---------- */

.poly-cta{
  padding:7rem 0 8rem;
  text-align:center;
}

.poly-cta h2{
  margin:0;
  font-family:var(--font-heading);
  font-size:clamp(2.2rem,4vw,3.4rem);
  color:var(--color-primary);
}

.poly-cta p{
  max-width:640px;
  margin:1.5rem auto 2.5rem;
  line-height:1.9;
  color:var(--color-text-light);
}

.cta-actions{
  display:flex;
  justify-content:center;
  gap:1rem;
  flex-wrap:wrap;
}

/* ---------- responsive ---------- */

@media(max-width:1000px){
  .poly-statement-grid,
  .poly-story-grid{
    grid-template-columns:1fr;
  }

  .poly-story-grid{
    display:flex;
    flex-direction:column-reverse;
  }

  .facts{
    grid-template-columns:1fr;
  }

  .capability-grid{
    grid-template-columns:repeat(2,1fr);
  }
}

@media(max-width:600px){
  .poly-statement{
    padding:5rem 0 4rem;
  }

  .poly-story,
  .poly-proof,
  .poly-products{
    padding:5rem 0;
  }

  .capability-grid{
    grid-template-columns:1fr;
  }

  .poly-cta{
    padding:5rem 0 6rem;
  }
}

</style>
