---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/Container.astro";
---

<BaseLayout
  title="About S R Group"
  description="Learn about the legacy, leadership and manufacturing excellence of S R Group."
>

<section class="hero">

  <Container>

    <span class="eyebrow">
      ABOUT S R GROUP
    </span>

    <h1>
      A Legacy Built on Trust,<br />
      Strengthened Through Generations.
    </h1>

    <p>
      Since 1997, S R Group has grown from a family vision into a trusted
      chemical manufacturing group, serving industries through quality,
      integrity and long-term relationships.
    </p>

  </Container>

</section>

<section class="story">

  <Container>

    <div class="story-grid">

      <div>

        <span class="section-title">
          OUR STORY
        </span>

        <h2>
          Building a Legacy Since 1997
        </h2>

      </div>

      <div>

        <p>
          Established in <strong>1997</strong> by the late
          <strong>Shri Ramanbhai Patel</strong>, together with
          <strong>Nilesh Patel</strong> and
          <strong>Krushi Patel</strong>, S R Group was founded on a simple
          principle — manufacture dependable products while building lasting
          customer relationships.
        </p>

        <p>
          Over the decades, the Group expanded into
          <strong>S R Industries</strong>,
          <strong>S R Plast</strong> and
          <strong>S R Polymers</strong>, serving customers across multiple
          industrial sectors through quality-focused manufacturing.
        </p>

        <p>
          Today,
          <strong>Henil Patel</strong> and
          <strong>Kushal Patel</strong> represent the next generation,
          continuing the family's vision while embracing innovation,
          modernization and future growth.
        </p>

      </div>

    </div>

  </Container>

</section>

<section class="companies">

  <Container>

    <span class="section-title">
      OUR COMPANIES
    </span>

    <h2>
     Built on Three Companies.<br />
      Driven by One Manufacturing Vision.
    </h2>

    <p class="companies-intro">
      S R Group brings together three registered companies with complementary expertise in chemical and resin manufacturing. Together, they form an integrated manufacturing ecosystem focused on quality, consistency, and reliable industrial solutions.
</p>

    <div class="company-grid">

     <a
  href={`${import.meta.env.BASE_URL}companies/industries`}
  class="company-card"
>

        <span class="company-type">
          INDUSTRIAL CHEMICALS
        </span>

        <h3>
          S R Industries &amp; S R Plast
        </h3>

        <p>
          Since 1997, S R Industries and S R Plast have been manufacturing industrial chemicals, distilled solvents, and custom chemical solutions for customers across diverse industries. Backed by decades of manufacturing expertise, we are committed to delivering consistent quality, dependable supply, and long-term value.
        </p>

     </a>

      <a
  href={`${import.meta.env.BASE_URL}companies/polymers`}
  class="company-card"
>

        <span class="company-type">
          UNSATURATED POLYESTER RESINS 
        </span>

        <h3>
          S R Polymers
        </h3>

        <p>
Founded in 2012, S R Polymers specializes in manufacturing Unsaturated Polyester Resins for composite and FRP applications. Our focus on product quality, technical excellence, and reliable performance enables us to serve manufacturers with solutions they can depend on.
        </p>

      </a>

    </div>

  </Container>

</section>
</BaseLayout>

<style>

.hero{
padding:8rem 0 6rem;
text-align:center;
}

.eyebrow{
display:inline-block;
margin-bottom:1rem;
font-size:.78rem;
letter-spacing:.28em;
text-transform:uppercase;
font-weight:600;
color:var(--color-accent);
}

.hero h1{
margin:0;
font-size:clamp(3rem,5vw,4.7rem);
line-height:1.1;
color:var(--color-primary);
}

.hero p{
max-width:760px;
margin:2rem auto 0;
line-height:2;
font-size:1.12rem;
}

.story{
padding:6rem 0;
}

.story-grid{
display:grid;
grid-template-columns:40% 60%;
gap:5rem;
}

.section-title{
display:inline-block;
margin-bottom:1rem;
letter-spacing:.28em;
font-size:.75rem;
font-weight:600;
color:var(--color-accent);
}

.story h2{
margin:0;
font-size:3rem;
color:var(--color-primary);
}

.story p{
line-height:2;
margin-bottom:2rem;
}

@media(max-width:900px){

.hero{
padding:6rem 0 5rem;
}

.story-grid{
grid-template-columns:1fr;
}

.story h2{
font-size:2.2rem;
}

}
.companies{
padding:6rem 0;
}

.companies-intro{
max-width:760px;
margin:2rem 0 4rem;
line-height:2;
font-size:1.08rem;
color:var(--color-text-light);
}

.company-grid{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:2rem;
}

.company-grid article{
padding:3rem;
background:#fff;
border:1px solid var(--color-border);
border-radius:22px;
transition:.3s ease;
}

.company-card:hover{
transform:translateY(-5px);
box-shadow:0 18px 40px rgba(0,0,0,.05);
}

.company-type{
display:inline-block;
margin-bottom:1rem;
font-size:.72rem;
font-weight:600;
letter-spacing:.25em;
text-transform:uppercase;
color:var(--color-accent);
}

.company-grid h3{
margin:0 0 1.5rem;
font-family:var(--font-heading);
font-size:2rem;
color:var(--color-primary);
}

.company-grid p{
margin:0;
line-height:2;
color:var(--color-text-light);
}

@media(max-width:900px){

.company-grid{
grid-template-columns:1fr;
}
.company-card{
display:block;
text-decoration:none;
color:inherit;
}

.company-card{
padding:2.25rem;
}

}
</style>


