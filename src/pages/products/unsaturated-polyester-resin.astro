---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/ui/Container.astro";

const applications = ["Boats", "Quartz & Marble", "FRP", "Roofing Sheets"];

const grades = [
  "GP",
  "GP Commercial",
  "Marble",
  "Sheet",
  "Button",
  "FRP",
  "Lamination",
  "Pultrusion",
  "SMC",
  "DMC",
  "Marine / Boat",
  "Orthophthalic (PTA Based)",
  "Isophthalic (PTA Based)",
  "Ortho Gelcoat",
  "ISO Gelcoat",
];
---

<BaseLayout
  title="Unsaturated Polyester Resin | S R Group"
  description="Unsaturated Polyester Resin manufactured by S R Polymers, across multiple grades."
>

<section class="range-intro">
  <Container>
    <span class="eyebrow">S R POLYMERS</span>
    <h1>Unsaturated Polyester Resin</h1>
    <p class="lead">
      Manufactured across multiple grades, developed for the applications
      below.
    </p>
  </Container>
</section>

<section class="range-body">
  <Container>
    <div class="category-block">
      <div class="category-group">
        <span class="group-label">Applications</span>
        <ul>
          {applications.map((item) => <li>{item}</li>)}
        </ul>
      </div>

           <div class="category-group">
        <span class="group-label">Grades</span>
        <ul class="grade-list">
          {grades.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <!-- Detailed specifications per grade to be added later -->
    </div>

    <div class="group-link">
      <a href={`${import.meta.env.BASE_URL}companies/polymers`}>
        Learn more about S R Polymers
      </a>
    </div>
  </Container>
</section>

</BaseLayout>

<style>


.eyebrow{
  display:inline-block;
  margin-bottom:1.25rem;
  font-size:.95rem;
  font-weight:700;
  letter-spacing:.24em;
  text-transform:uppercase;
  color:var(--color-accent);
  border-left:3px solid var(--color-accent);
  padding-left:.75rem;
}

.lead{
  font-size:var(--lead-size);
  line-height:var(--lead-line);
  color:var(--color-text-light);
  max-width:60ch;
}

.range-intro{
  padding:4rem 0 2.5rem;
}

.range-intro h1{
  margin:0 0 1.25rem;
  font-family:var(--font-heading);
  font-size:var(--h1-size);
  line-height:1.1;
  color:var(--color-primary);
}

.range-body{
  padding:0 0 3.5rem;
}

.category-block{
  padding:var(--card-pad);
  background:var(--color-bg);
  border:1px solid var(--color-border);
  border-radius:var(--radius);
  max-width:640px;
}

.category-group{
  margin-bottom:1.5rem;
}

.category-group:last-child{
  margin-bottom:0;
}

.grade-list{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:0 2rem;
}

.group-label{
  display:block;
  margin-bottom:.6rem;
  font-size:.7rem;
  font-weight:600;
  letter-spacing:.16em;
  text-transform:uppercase;
  color:var(--color-accent);
}

.category-group ul{
  margin:0;
  padding:0;
  list-style:none;
}

.category-group li{
  padding:.4rem 0;
  font-size:1rem;
  color:var(--color-text);
  border-bottom:1px solid var(--color-border);
}

.category-group li:last-child{
  border-bottom:none;
}

.group-link{
  margin-top:2rem;
}

.group-link a{
  font-size:.95rem;
  font-weight:600;
  color:var(--color-primary);
  text-decoration:none;
  border-bottom:1px solid var(--color-accent);
  padding-bottom:2px;
}

.group-link a:hover{
  color:var(--color-accent);
}

@media(max-width:600px){
  .range-intro{
    padding:3rem 0 2rem;
  }

  .grade-list{
    grid-template-columns:1fr;
  }
}
</style>
