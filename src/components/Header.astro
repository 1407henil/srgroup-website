---
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + "/";

const path = Astro.url.pathname.replace(base, "/");

const isActive = (href: string) =>
  path === href || path.startsWith(href + "/");
---

<header class="site-header">

  <div class="header-container">

  <a href={base} class="logo">

  <img
    src={`${base}assets/logo/1.svg`}
    alt="S R Group"
    class="logo-icon"
  />

  <div class="logo-text">

    <span class="logo-title">
      S R Group
    </span>

    <span class="logo-subtitle">
      ESTABLISHED 1997
    </span>

  </div>

</a>

    <nav>

      <a
        href={base}
        class:list={[{ active: path === "/" }]}
      >
        Home
      </a>

      <a
        href={`${base}about`}
        class:list={[{ active: isActive("/about") }]}
      >
        About
      </a>

      <a
        href={`${base}companies`}
        class:list={[{ active: isActive("/companies") }]}
      >
        Companies
      </a>

      <a
        href={`${base}products`}
        class:list={[{ active: isActive("/products") }]}
      >
        Products
      </a>

      <a
        href={`${base}contact`}
        class:list={[{ active: isActive("/contact") }]}
      >
        Contact
      </a>

    </nav>

  </div>

</header>

<style>

.site-header{
position:sticky;
top:0;
z-index:1000;
background:rgba(253,249,243,.88);
backdrop-filter:blur(18px);
border-bottom:1px solid rgba(196,154,42,.15);
}

.header-container{
max-width:1240px;
margin:auto;
padding:1rem 2rem;
display:flex;
justify-content:space-between;
align-items:center;
}

.logo{
display:flex;
align-items:center;
gap:.15rem;
text-decoration:none;
flex-shrink:0;
}

.logo-icon{
width:60px;
height:auto;
display:block;
flex-shrink:0;
}

.logo-text{
display:flex;
flex-direction:column;
justify-content:center;
margin-top:-1px;
}

.logo-title{
font-family:var(--font-heading);
font-size:2.45rem;
font-weight:700;
line-height:.95;
letter-spacing:-0.02em;
color:var(--color-accent);
}

.logo-subtitle{
margin-top:.32rem;
font-size:.68rem;
font-weight:600;
letter-spacing:.42em;
text-transform:uppercase;
color:#8E8E8E;
line-height:1;
}

nav{
display:flex;
align-items:center;
gap:2.25rem;
}

nav a{
position:relative;
text-decoration:none;
font-size:.95rem;
font-weight:500;
letter-spacing:.02em;
color:var(--color-primary);
transition:.25s;
}

nav a:hover{
color:var(--color-accent);
}

nav a.active{
color:var(--color-accent);
}

nav a.active::after{
content:"";
position:absolute;
left:0;
right:0;
bottom:-10px;
height:2px;
background:var(--color-accent);
}

@media(max-width:900px){

.header-container{
padding:1rem 1.25rem;
}

.logo-icon{
height:42px;
}

.logo-title{
font-size:1.55rem;
}

.logo-subtitle{
font-size:.5rem;
letter-spacing:.22em;
}

nav{
gap:1.2rem;
overflow-x:auto;
}

nav a{
white-space:nowrap;
font-size:.88rem;
}

}

</style>
