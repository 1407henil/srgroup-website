---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/ui/Container.astro";

const icons = {
  droplet: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z" /></svg>`,
  package: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z" /><path d="M12 22V12" /><polyline points="3.29 7 12 12 20.71 7" /><path d="m7.5 4.27 9 5.15" /></svg>`,
  gem: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.5 3 8 9l4 13 4-13-2.5-6" /><path d="M17 3a2 2 0 0 1 1.6.8l3 4a2 2 0 0 1 .013 2.382l-7.99 10.986a2 2 0 0 1-3.247 0l-7.99-10.986A2 2 0 0 1 2.4 7.8l2.998-3.997A2 2 0 0 1 7 3z" /><path d="M2 9h20" /></svg>`,
  rectangleHorizontal: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="12" x="2" y="6" rx="2" /></svg>`,
  circle: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /></svg>`,
  box: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" /><path d="m3.3 7 8.7 5 8.7-5" /><path d="M12 22V12" /></svg>`,
  layers: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z" /><path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12" /><path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17" /></svg>`,
  moveRight: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8L22 12L18 16" /><path d="M2 12H22" /></svg>`,
  square: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" /></svg>`,
  shapes: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8.3 10a.7.7 0 0 1-.626-1.079L11.4 3a.7.7 0 0 1 1.198-.043L16.3 8.9a.7.7 0 0 1-.572 1.1Z" /><rect x="3" y="14" width="7" height="7" rx="1" /><circle cx="17.5" cy="17.5" r="3.5" /></svg>`,
  anchor: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6v16" /><path d="m19 13 2-1a9 9 0 0 1-18 0l2 1" /><path d="M9 11h6" /><circle cx="12" cy="4" r="2" /></svg>`,
  flaskConical: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2v6a2 2 0 0 0 .245.96l5.51 10.08A2 2 0 0 1 18 22H6a2 2 0 0 1-1.755-2.96l5.51-10.08A2 2 0 0 0 10 8V2" /><path d="M6.453 15h11.094" /><path d="M8.5 2h7" /></svg>`,
  testTube: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2v17.5c0 1.4-1.1 2.5-2.5 2.5c-1.4 0-2.5-1.1-2.5-2.5V2" /><path d="M8.5 2h7" /><path d="M14.5 16h-5" /></svg>`,
  paintBucket: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 7 6 2" /><path d="M18.992 12H2.041" /><path d="M21.145 18.38A3.34 3.34 0 0 1 20 16.5a3.3 3.3 0 0 1-1.145 1.88c-.575.46-.855 1.02-.855 1.595A2 2 0 0 0 20 22a2 2 0 0 0 2-2.025c0-.58-.285-1.13-.855-1.595" /><path d="m8.5 4.5 2.148-2.148a1.205 1.205 0 0 1 1.704 0l7.296 7.296a1.205 1.205 0 0 1 0 1.704l-7.592 7.592a3.615 3.615 0 0 1-5.112 0l-3.888-3.888a3.615 3.615 0 0 1 0-5.112L5.67 7.33" /></svg>`,
  sprayCan: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3h.01" /><path d="M7 5h.01" /><path d="M11 7h.01" /><path d="M3 7h.01" /><path d="M7 9h.01" /><path d="M3 11h.01" /><rect width="4" height="4" x="15" y="5" /><path d="m19 9 2 2v10c0 .6-.4 1-1 1h-6c-.6 0-1-.4-1-1V11l2-2" /><path d="m13 14 8-2" /><path d="m13 19 8-2" /></svg>`,
};

const grades = [
  { slug: "gp", name: "GP", sub: "General Purpose", icon: "droplet",
    desc: "Our foundational general-purpose grade, formulated for versatile hand lay-up and open-mould fabrication across a wide range of FRP products.",
    app: "Hand lay-up laminates, moulded components, general FRP fabrication." },
  { slug: "gp-commercial", name: "GP Commercial", sub: "Economy General Purpose", icon: "package",
    desc: "An economy-focused variant of our general-purpose resin, suited to cost-sensitive fabrication where high-volume output matters most.",
    app: "Volume-driven FRP production, commercial moulding, economy laminates." },
  { slug: "marble", name: "Marble", sub: "Artificial Marble & Cast Stone", icon: "gem",
    desc: "Formulated for artificial marble and engineered stone casting, offering the flow and finish needed for decorative surface products.",
    app: "Artificial marble, cast stone surfaces, decorative panels." },
  { slug: "sheet", name: "Sheet", sub: "FRP Sheet & Roofing", icon: "rectangleHorizontal",
    desc: "Engineered for FRP sheet production, including corrugated and flat roofing and panel sheets.",
    app: "Corrugated roofing sheets, flat FRP panels, cladding." },
  { slug: "button", name: "Button", sub: "Moulded Resin Buttons", icon: "circle",
    desc: "A specialised grade for the compression moulding of resin buttons, balancing flow and cure for fine decorative detail.",
    app: "Resin buttons, small moulded decorative components." },
  { slug: "frp", name: "FRP", sub: "General FRP Fabrication", icon: "box",
    desc: "A general fabrication grade for fibre-reinforced plastic components across tanks, panels and structural parts.",
    app: "FRP tanks, panels, enclosures, structural components." },
  { slug: "lamination", name: "Lamination", sub: "Hand Lay-Up Lamination", icon: "layers",
    desc: "Formulated for multi-layer hand lay-up lamination, giving consistent wet-out and bond strength through successive glass layers.",
    app: "Hand lay-up laminates, multi-layer FRP lamination." },
  { slug: "pultrusion", name: "Pultrusion", sub: "Continuous Profile Pultrusion", icon: "moveRight",
    desc: "Engineered for the continuous pultrusion process, with a cure profile suited to sustained pulling speeds and uniform cross-sections.",
    app: "Pultruded profiles, rods, structural sections." },
  { slug: "smc", name: "SMC", sub: "Sheet Moulding Compound", icon: "square",
    desc: "A resin base for Sheet Moulding Compound, formulated for compression-moulded parts requiring dimensional stability and surface quality.",
    app: "SMC compression-moulded components, automotive and electrical parts." },
  { slug: "dmc", name: "DMC", sub: "Dough Moulding Compound", icon: "shapes",
    desc: "A resin base for Dough Moulding Compound, suited to intricate compression-moulded parts including electrical components.",
    app: "DMC moulded parts, electrical components, housings." },
  { slug: "marine", name: "Marine / Boat", sub: "Marine & Boat Building", icon: "anchor",
    desc: "Formulated with water and hydrolysis resistance for boat building and marine fabrication.",
    app: "Boat hulls, marine structures, water-contact FRP parts." },
  { slug: "ortho", name: "Orthophthalic (PTA Based)", sub: "General-Purpose Chemical Resistance", icon: "flaskConical",
    desc: "Our orthophthalic-based resin, offering reliable general-purpose mechanical properties at an efficient cost for everyday FRP use.",
    app: "General FRP fabrication, tanks, panels, economical laminates." },
  { slug: "iso", name: "Isophthalic (PTA Based)", sub: "Higher Chemical & Water Resistance", icon: "testTube",
    desc: "Our isophthalic-based resin, formulated for improved chemical, thermal and water resistance over standard orthophthalic grades.",
    app: "Chemical storage tanks, pipes, higher-performance FRP components." },
  { slug: "ortho-gelcoat", name: "Ortho Gelcoat", sub: "Standard Surface Finish Coat", icon: "paintBucket",
    desc: "An orthophthalic-based gelcoat formulated for a smooth, weather-resistant outer surface finish over FRP laminates.",
    app: "Surface finishing coat for ortho-based FRP laminates." },
  { slug: "iso-gelcoat", name: "ISO Gelcoat", sub: "Premium & Marine-Grade Finish Coat", icon: "sprayCan",
    desc: "An isophthalic-based gelcoat for superior water, chemical and UV resistance, suited to premium and marine-grade finishes.",
    app: "Marine and premium-grade surface finishes, high-exposure FRP coatings." },
];

const pickerCSS = grades.map((g) => `
#grade-${g.slug}:checked ~ .picker-grid label[for="grade-${g.slug}"]{
  background:#fff;
  border-left-color:var(--color-accent);
}
#grade-${g.slug}:checked ~ .picker-grid .panel-${g.slug}{
  display:block;
}
`).join("");
---

<BaseLayout
  title="Unsaturated Polyester Resin | S R Polymers"
  description="Explore the full range of Unsaturated Polyester Resin grades manufactured by S R Polymers, each formulated for a specific fabrication process or finish."
>

<section class="hero">

  <Container>

    <a href={`${import.meta.env.BASE_URL}companies/polymers`} class="eyebrow-link">S R POLYMERS</a>

    <h1>
      Unsaturated Polyester Resin
    </h1>

    <p>
      Unsaturated Polyester Resin is a versatile thermosetting resin used
      across composite, FRP and moulding industries. At S R Polymers, each
      grade is formulated for a specific process or finish — from
      general-purpose fabrication to marine-grade gelcoats — so fabricators
      can select the resin suited to their exact application.
    </p>

  </Container>

</section>

<section class="picker">

  <Container>

    <div class="picker-shell">

      {grades.map((g) => (
        <input type="radio" name="grade" id={`grade-${g.slug}`} class="grade-radio" checked={g.slug === "gp"} />
      ))}

      <div class="picker-grid">

        <div class="grade-list">

          {grades.map((g) => (
            <label for={`grade-${g.slug}`} class="grade-item">
              <span class="item-icon" set:html={icons[g.icon]} />
              <span class="item-text">
                <span class="item-name">{g.name}</span>
                <span class="item-sub">{g.sub}</span>
              </span>
            </label>
          ))}

        </div>

        <div class="grade-panels">

          {grades.map((g) => (
            <div class={`grade-panel panel-${g.slug}`}>
              <span class="panel-icon" set:html={icons[g.icon]} />
              <span class="panel-sub">{g.sub}</span>
              <h2>{g.name}</h2>
              <p class="panel-desc">{g.desc}</p>
              <p class="panel-app"><strong>Applications —</strong> {g.app}</p>
            </div>
          ))}

        </div>

      </div>

    </div>

  </Container>

</section>

</BaseLayout>

<style>

.hero{
padding:var(--section-space) 0 2rem;
}

.eyebrow-link{
display:inline-block;
margin-bottom:1rem;
font-size:.75rem;
font-weight:600;
letter-spacing:.28em;
text-transform:uppercase;
text-decoration:none;
color:var(--color-accent);
}

.hero h1{
margin:0;
font-family:var(--font-heading);
font-size:var(--h1-size);
color:var(--color-primary);
}

.hero p{
max-width:720px;
margin:1.5rem 0 0;
font-size:var(--lead-size);
line-height:var(--lead-line);
color:var(--color-text-light);
}

.picker{
padding:1rem 0 var(--section-space);
}

.picker-shell{
position:relative;
}

.grade-radio{
position:absolute;
width:1px;
height:1px;
opacity:0;
pointer-events:none;
}

.picker-grid{
display:grid;
grid-template-columns:300px 1fr;
gap:2.5rem;
align-items:start;
}

.grade-list{
display:flex;
flex-direction:column;
border:1px solid var(--color-border);
border-radius:var(--radius);
overflow:hidden;
}

.grade-item{
display:flex;
align-items:center;
gap:.85rem;
padding:.9rem 1.1rem;
border-left:3px solid transparent;
border-bottom:1px solid var(--color-border);
background:var(--color-bg);
cursor:pointer;
transition:var(--transition);
}

.grade-list .grade-item:last-child{
border-bottom:none;
}

.grade-item:hover{
background:#fff;
}

.item-icon{
flex-shrink:0;
display:inline-flex;
color:var(--color-accent);
}

.item-icon :global(svg){
width:18px;
height:18px;
}

.item-text{
display:flex;
flex-direction:column;
}

.item-name{
font-family:var(--font-heading);
font-size:1.02rem;
color:var(--color-primary);
}

.item-sub{
font-size:.76rem;
color:var(--color-text-light);
}

.grade-panel{
display:none;
padding:var(--card-pad);
border:1px solid var(--color-border);
border-radius:var(--radius);
background:#fff;
}

.panel-icon{
display:inline-flex;
margin-bottom:1.25rem;
color:var(--color-accent);
}

.panel-icon :global(svg){
width:34px;
height:34px;
}

.panel-sub{
display:block;
margin-bottom:.4rem;
font-size:.75rem;
font-weight:600;
letter-spacing:.2em;
text-transform:uppercase;
color:var(--color-accent);
}

.grade-panel h2{
margin:0 0 1rem;
font-family:var(--font-heading);
font-size:var(--h3-size);
color:var(--color-primary);
}

.panel-desc{
margin:0 0 1rem;
font-size:1rem;
line-height:1.8;
color:var(--color-text-light);
}

.panel-app{
margin:0;
font-size:.95rem;
line-height:1.8;
color:var(--color-text-light);
}

.panel-app strong{
color:var(--color-primary);
}

</style>

<style set:html={pickerCSS}></style>
