---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/ui/Container.astro";

const capabilities = [
  {
    title: "Since 1997",
    text: "Nearly three decades of continuous chemical manufacturing at our Chhatral facility.",
  },
  {
    title: "Integrated Manufacturing Operations",
    text: "Distillation, processing, and packaging carried out under one roof.",
  },
  {
    title: "Precision-Controlled Production Processes",
    text: "Process parameters monitored and controlled at every stage of production.",
  },
  {
    title: "Consistent Batch Quality",
    text: "Quality checked at each stage to maintain consistency, batch after batch.",
  },
  {
    title: "Bulk Manufacturing Capability",
    text: "Equipped to handle bulk industrial volumes for regular, ongoing supply.",
  },
  {
    title: "Reliable Packaging & Dispatch",
    text: "Products packaged and dispatched to meet agreed delivery schedules.",
  },
];
---

<BaseLayout
  title="S R Industries & S R Plast | S R Group"
  description="S R Industries and S R Plast are part of S R Group's chemical manufacturing business, with specialized expertise in glycol distillation."
>

<!-- ================= STATEMENT ================= -->
<section class="ind-statement">
  <Container>
    <div class="ind-statement-grid">
      <div class="ind-statement-text">
        <span class="eyebrow">CHEMICAL MANUFACTURING</span>

        <h1>Precision, refined into every batch.</h1>

        <p class="lead">
          S R Industries and S R Plast manufacture industrial chemicals from
          our facility in Chhatral GIDC, Gujarat — built on nearly three
          decades of process discipline.
        </p>

        <div class="facts">
          <div class="fact">
            <span>Established</span>
            <strong>1997</strong>
          </div>
          <div class="fact">
            <span>Location</span>
            <strong>Chhatral GIDC, Gujarat</strong>
          </div>
          <div class="fact">
            <span>Specialization</span>
            <strong>Glycol Distillation &amp; Chemical Processing</strong>
          </div>
        </div>
      </div>

      <!-- PHOTO SLOT: wide facility exterior or plant overview shot -->
      <div class="photo-slot photo-tall">
        <span>Facility photo</span>
      </div>
    </div>
  </Container>
</section>

<!-- ================= STORY ================= -->
<section class="ind-story">
  <Container>
    <div class="ind-story-grid">
      <!-- PHOTO SLOT: distillation unit / production line close-up -->
      <div class="photo-slot photo-square">
        <span>Facility photo</span>
      </div>

      <div class="ind-story-text">
        <span class="eyebrow">OUR STORY</span>
        <h2>Manufacturing Excellence Since 1997</h2>

        <p>
          Established in 1997, S R Industries and S R Plast are part of S R
          Group's chemical manufacturing business. Operating from our
          facility at Chhatral GIDC, Gujarat, the companies have built
          expertise in chemical manufacturing, with glycol distillation
          forming a core area of capability.
        </p>

        <p>
          Manufacturing runs on integrated operations, with process control
          and quality monitoring built into every stage — supported by
          continuous improvement across the years.
        </p>
      </div>
    </div>
  </Container>
</section>

<!-- ================= PROOF ================= -->
<section class="ind-proof">
  <Container>
    <span class="eyebrow">CAPABILITIES</span>
    <h2>Manufacturing Capabilities</h2>

    <div class="capability-grid">
      {capabilities.map((item) => (
        <div class="capability-card">
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </div>
      ))}
    </div>
  </Container>
</section>

<!-- ================= PRODUCTS ================= -->
<section class="ind-products">
  <Container>
    <span class="eyebrow">PRODUCT RANGE</span>
    <h2>Our Product Range</h2>
    <p class="lead">
      Glycols and chlorinated solvents across distilled and pure grades,
      supplied to meet a variety of industrial specifications.
    </p>

    <div class="category-grid">
      <div class="category-block">
        <h3>Distilled</h3>

        <div class="category-group">
          <span class="group-label">Glycols</span>
          <ul>
            <li>Mono Ethylene Glycol (MEG)</li>
            <li>Diethylene Glycol (DEG)</li>
            <li>Triethylene Glycol (TEG)</li>
          </ul>
        </div>

        <div class="category-group">
          <span class="group-label">Chlorinated</span>
          <ul>
            <li>Trichloroethylene (TCE)</li>
            <li>EDC LE</li>
          </ul>
        </div>
      </div>

      <div class="category-block">
        <h3>Pure</h3>

        <div class="category-group">
          <span class="group-label">Glycols</span>
          <ul>
            <li>Mono Ethylene Glycol (MEG)</li>
            <li>Diethylene Glycol (DEG)</li>
          </ul>
        </div>

        <div class="category-group">
          <span class="group-label">Chlorinated</span>
          <ul>
            <li>SRSolv</li>
          </ul>
        </div>
      </div>
    </div>

    <div class="catalogue-link">
      <a href={`${import.meta.env.BASE_URL}products`} class="button">
        View Full Product Catalogue
      </a>
    </div>
  </Container>
</section>

<!-- ================= CTA ================= -->
<section class="ind-cta">
  <Container>
    <h2>Looking for a Specific Chemical Product?</h2>
    <p>
      Explore our range of industrial chemicals and specialized glycol-based
      products.
    </p>

    <div class="cta-actions">
      <a href={`${import.meta.env.BASE_URL}products`} class="button">
        View Product Catalogue
      </a>
      <a href={`${import.meta.env.BASE_URL}contact`} class="button secondary">
        Contact Our Team
      </a>
    </div>
  </Container>
</section>

</BaseLayout>


<style>

/* ---------- shared ---------- */

.eyebrow{
  display:inline-block;
  margin-bottom:1.25rem;
  font-size:.95rem;
  font-weight:700;
  letter-spacing:.24em;
  text-transform:uppercase;
  color:var(--color-accent);
  border-left:3px solid var(--color-accent);
  padding-left:.75rem;
}

.lead{
  font-size:1.1rem;
  line-height:1.9;
  color:var(--color-text-light);
}

.button{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding:1rem 2.25rem;
  border:1px solid var(--color-accent);
  border-radius:999px;
  text-decoration:none;
  font-weight:600;
  color:var(--color-primary);
  transition:var(--transition);
}

.button:hover{
  background:var(--color-accent);
  color:#fff;
}

.button.secondary{
  background:transparent;
}

.photo-slot{
  display:flex;
  align-items:center;
  justify-content:center;
  border:1px dashed var(--color-border);
  border-radius:var(--radius);
  background:#F1EEE6;
  color:var(--color-text-light);
  font-size:.85rem;
  font-style:italic;
}

.photo-tall{
  aspect-ratio:4/5;
}

.photo-square{
  aspect-ratio:1/1;
}

/* ---------- statement ---------- */

.ind-statement{
  padding:7rem 0 6rem;
}

.ind-statement-grid{
  display:grid;
  grid-template-columns:1.1fr .9fr;
  gap:4rem;
  align-items:center;
}

.ind-statement h1{
  margin:0;
  font-family:var(--font-heading);
  font-size:clamp(2.8rem,5vw,4.6rem);
  line-height:1.05;
  color:var(--color-primary);
}

.ind-statement .lead{
  margin:1.75rem 0 0;
  max-width:52ch;
}

.facts{
  margin-top:3rem;
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:1.5rem;
  padding-top:2rem;
  border-top:1px solid var(--color-border);
}

.fact{
  display:flex;
  flex-direction:column;
  gap:.4rem;
}

.fact span{
  font-size:.7rem;
  font-weight:600;
  letter-spacing:.16em;
  text-transform:uppercase;
  color:var(--color-accent);
}

.fact strong{
  font-size:.95rem;
  font-weight:600;
  color:var(--color-primary);
}

/* ---------- story ---------- */

.ind-story{
  padding:6rem 0;
  background:#F5F1E9;
}

.ind-story-grid{
  display:grid;
  grid-template-columns:.85fr 1.15fr;
  gap:4rem;
  align-items:center;
}

.ind-story-text h2{
  margin:0;
  font-family:var(--font-heading);
  font-size:clamp(2.2rem,3.5vw,3.2rem);
  line-height:1.15;
  color:var(--color-primary);
}

.ind-story-text p{
  margin:1.5rem 0 0;
  font-size:1.05rem;
  line-height:1.9;
  color:var(--color-text-light);
  max-width:60ch;
}

/* ---------- proof ---------- */

.ind-proof{
  padding:7rem 0;
}

.ind-proof h2{
  margin:0 0 3.5rem;
  font-family:var(--font-heading);
  font-size:clamp(2.2rem,3.5vw,3.2rem);
  color:var(--color-primary);
}

.capability-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:2px;
  background:var(--color-border);
  border:1px solid var(--color-border);
}

.capability-card{
  padding:2.5rem;
  background:var(--color-bg);
  border-left:3px solid transparent;
  transition:var(--transition);
}

.capability-card:hover{
  border-left-color:var(--color-accent);
  background:#fff;
}

.capability-card h3{
  margin:0 0 .85rem;
  font-family:var(--font-heading);
  font-size:1.4rem;
  color:var(--color-primary);
}

.capability-card p{
  margin:0;
  font-size:.98rem;
  line-height:1.7;
  color:var(--color-text-light);
}

/* ---------- products ---------- */

.ind-products{
  padding:7rem 0;
  background:#F5F1E9;
}

.ind-products h2{
  margin:.5rem 0 0;
  font-family:var(--font-heading);
  font-size:clamp(2.2rem,3.5vw,3.2rem);
  color:var(--color-primary);
}

.ind-products > :global(.container) > .lead{
  margin:1.25rem 0 3.5rem;
  max-width:60ch;
}

.category-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:3rem;
}

.category-block{
  padding:2.5rem;
  background:var(--color-bg);
  border:1px solid var(--color-border);
  border-radius:var(--radius);
}

.category-block h3{
  margin:0 0 1.75rem;
  font-family:var(--font-heading);
  font-size:1.75rem;
  color:var(--color-primary);
}

.category-group{
  margin-bottom:1.5rem;
}

.category-group:last-child{
  margin-bottom:0;
}

.group-label{
  display:block;
  margin-bottom:.6rem;
  font-size:.7rem;
  font-weight:600;
  letter-spacing:.16em;
  text-transform:uppercase;
  color:var(--color-accent);
}

.category-group ul{
  margin:0;
  padding:0;
  list-style:none;
}

.category-group li{
  padding:.4rem 0;
  font-size:1rem;
  color:var(--color-text);
  border-bottom:1px solid var(--color-border);
}

.category-group li:last-child{
  border-bottom:none;
}

.catalogue-link{
  margin-top:3.5rem;
  text-align:center;
}

/* ---------- cta ---------- */

.ind-cta{
  padding:7rem 0 8rem;
  text-align:center;
}

.ind-cta h2{
  margin:0;
  font-family:var(--font-heading);
  font-size:clamp(2.2rem,4vw,3.4rem);
  color:var(--color-primary);
}

.ind-cta p{
  max-width:640px;
  margin:1.5rem auto 2.5rem;
  line-height:1.9;
  color:var(--color-text-light);
}

.cta-actions{
  display:flex;
  justify-content:center;
  gap:1rem;
  flex-wrap:wrap;
}

/* ---------- responsive ---------- */

@media(max-width:1000px){
  .ind-statement-grid,
  .ind-story-grid{
    grid-template-columns:1fr;
  }

  .ind-story-grid{
    display:flex;
    flex-direction:column-reverse;
  }

  .facts{
    grid-template-columns:1fr;
  }

  .capability-grid{
    grid-template-columns:repeat(2,1fr);
  }

  .category-grid{
    grid-template-columns:1fr;
  }
}

@media(max-width:600px){
  .ind-statement{
    padding:5rem 0 4rem;
  }

  .ind-story,
  .ind-proof,
  .ind-products{
    padding:5rem 0;
  }

  .capability-grid{
    grid-template-columns:1fr;
  }

  .ind-cta{
    padding:5rem 0 6rem;
  }
}

</style>
