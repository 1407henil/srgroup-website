---
import Container from "./Container.astro";
---

<footer class="site-footer">

  <Container>

    <div class="footer-main">

      <div class="footer-brand">

        <img
  src={`${import.meta.env.BASE_URL}assets/logo/sr-group.svg`}
  alt="S R Group"
  class="footer-logo"
/>

        <p class="footer-tagline">
          Chemical Manufacturing Excellence Since 1997.
        </p>

      </div>

      <div class="footer-columns">

        <div class="footer-column">

          <h4>Companies</h4>

          <ul>

            <li>
              <a href={`${import.meta.env.BASE_URL}companies/industries`}>
                S R Industries
              </a>
            </li>

            <li>
              <a href={`${import.meta.env.BASE_URL}companies/industries`}>
                S R Plast
              </a>
            </li>

            <li>
              <a href={`${import.meta.env.BASE_URL}companies/polymers`}>
                S R Polymers
              </a>
            </li>

          </ul>

        </div>

        <div class="footer-column">

          <h4>Explore</h4>

          <ul>

            <li><a href={`${import.meta.env.BASE_URL}products`}>Products</a></li>
            <li><a href={`${import.meta.env.BASE_URL}industries`}>Industries Served</a></li>
            <li><a href={`${import.meta.env.BASE_URL}infrastructure`}>Infrastructure</a></li>
            <li><a href={`${import.meta.env.BASE_URL}quality`}>Quality Assurance</a></li>
            <li><a href={`${import.meta.env.BASE_URL}downloads`}>Downloads</a></li>

          </ul>

        </div>

        <div class="footer-column">

          <h4>Contact</h4>

          <ul class="contact-list">

            <li>
              <a href="mailto:info@srindp.com">
                info@srindp.com
              </a>
            </li>

            <li>
              Chhatral GIDC,<br>
              Gandhinagar, Gujarat
            </li>

            <li>
              <a href={`${import.meta.env.BASE_URL}contact`}>
                Get in touch →
              </a>
            </li>

          </ul>

        </div>

      </div>

    </div>

    <div class="footer-bottom">

            <span class="copyright">
        © {new Date().getFullYear()} S R Group. All rights reserved.
      </span>

      <span>
        S R Industries &nbsp;•&nbsp; S R Plast &nbsp;•&nbsp; S R Polymers
      </span>

    </div>

  </Container>

</footer>

<style>


.site-footer{
margin-top:3.5rem;
padding:3rem 0 1.75rem;
background:var(--color-bg);
border-top:1px solid rgba(196,154,42,.28);
}

.footer-main{
display:grid;
grid-template-columns:1fr 2fr;
gap:3rem;
align-items:start;
}

.footer-brand{
display:flex;
flex-direction:column;
align-items:center;
text-align:center;
}

.footer-logo{
width:280px;
max-width:100%;
height:auto;
display:block;
}

.footer-tagline{
margin:1rem 0 0;
font-size:.95rem;
line-height:1.65;
color:var(--color-text-light);
text-align:center;
white-space:normal;
max-width:420px;
}

.footer-columns{
display:grid;
grid-template-columns:repeat(3,minmax(150px,1fr));
gap:2.5rem;
}

.footer-column h4{
display:flex;
align-items:center;
gap:.6rem;
margin:0 0 1.25rem;
font-size:.72rem;
font-weight:600;
letter-spacing:.28em;
text-transform:uppercase;
color:var(--color-accent);
}

.footer-column h4::before{
content:"";
width:24px;
height:1px;
background:var(--color-accent);
opacity:.7;
}

.footer-column ul{
margin:0;
padding:0;
list-style:none;
display:flex;
flex-direction:column;
gap:.85rem;
}

.footer-column li{
font-size:1rem;
line-height:1.7;
color:var(--color-text);
}

.footer-column a{
color:inherit;
text-decoration:none;
transition:.25s ease;
}

.footer-column a:hover{
color:var(--color-accent);
}

.contact-list{
gap:1.1rem;
}

.footer-bottom{
margin-top:3rem;
padding-top:1.25rem;
border-top:1px dashed rgba(196,154,42,.45);
display:flex;
justify-content:space-between;
align-items:center;
gap:2rem;
font-size:.88rem;
color:#6D7090;
}

.copyright{
font-family:"Courier New", Courier, monospace;
letter-spacing:.02em;
}

@media (max-width:1000px){

.footer-main{
grid-template-columns:1fr;
gap:2.5rem;
}

.footer-columns{
grid-template-columns:1fr;
gap:2rem;
}

.footer-tagline{
white-space:normal;
}

.footer-bottom{
flex-direction:column;
align-items:flex-start;
}

.footer-logo{
width:200px;
}

}
</style>
