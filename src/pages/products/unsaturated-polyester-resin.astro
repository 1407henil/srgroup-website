---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/ui/Container.astro";

const applications = ["Boats", "Quartz & Marble", "FRP", "Roofing Sheets"];
---

<BaseLayout
  title="Unsaturated Polyester Resin | S R Group"
  description="Unsaturated Polyester Resin manufactured by S R Polymers, across multiple grades."
>

<section class="range-intro">
  <Container>
    <span class="eyebrow">S R POLYMERS</span>
    <h1>Unsaturated Polyester Resin</h1>
    <p class="lead">
      Manufactured across multiple grades, developed for the applications
      below.
    </p>
  </Container>
</section>

<section class="range-body">
  <Container>
    <div class="category-block">
      <div class="category-group">
        <span class="group-label">Applications</span>
        <ul>
          {applications.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <!-- Grade list and detailed specifications to be added later -->
    </div>

    <div class="group-link">
      <a href={`${import.meta.env.BASE_URL}companies/polymers`}>
        Learn more about S R Polymers
      </a>
    </div>
  </Container>
</section>

</BaseLayout>

<style>

.eyebrow{
  display:inline-block;
  margin-bottom:1.25rem;
  font-size:.95rem;
  font-weight:700;
  letter-spacing:.24em;
  text-transform:uppercase;
  color:var(--color-accent);
  border-left:3px solid var(--color-accent);
  padding-left:.75rem;
}

.lead{
  font-size:1.1rem;
  line-height:1.9;
  color:var(--color-text-light);
  max-width:60ch;
}

.range-intro{
  padding:7rem 0 4rem;
}

.range-intro h1{
  margin:0 0 1.5rem;
  font-family:var(--font-heading);
  font-size:clamp(2.6rem,5vw,4rem);
  line-height:1.05;
  color:var(--color-primary);
}

.range-body{
  padding:0 0 6rem;
}

.category-block{
  padding:2.5rem;
  background:var(--color-bg);
  border:1px solid var(--color-border);
  border-radius:var(--radius);
  max-width:560px;
}

.category-group{
  margin-bottom:0;
}

.group-label{
  display:block;
  margin-bottom:.6rem;
  font-size:.7rem;
  font-weight:600;
  letter-spacing:.16em;
  text-transform:uppercase;
  color:var(--color-accent);
}

.category-group ul{
  margin:0;
  padding:0;
  list-style:none;
}

.category-group li{
  padding:.4rem 0;
  font-size:1rem;
  color:var(--color-text);
  border-bottom:1px solid var(--color-border);
}

.category-group li:last-child{
  border-bottom:none;
}

.group-link{
  margin-top:2.5rem;
}

.group-link a{
  font-size:.95rem;
  font-weight:600;
  color:var(--color-primary);
  text-decoration:none;
  border-bottom:1px solid var(--color-accent);
  padding-bottom:2px;
}

.group-link a:hover{
  color:var(--color-accent);
}

@media(max-width:600px){
  .range-intro{
    padding:5rem 0 3rem;
  }
}

</style>
